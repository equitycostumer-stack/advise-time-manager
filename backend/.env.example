# PostgreSQL/Supabase
DATABASE_URL=postgresql://usuario:contraseña@host:5432/base

# Debe ser un secreto aleatorio de al menos 32 caracteres
JWT_SECRET=CAMBIA_ESTE_VALOR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=24h

# Producción
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=https://tu-frontend.vercel.app

# Opcionales: correo de alertas
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEST_MODE=true
